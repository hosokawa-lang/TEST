Public Class frmSetup

'セットアップバージョン構造体
Public Structure stVersion
	Dim bSelect		As Boolean			'セットアップ選択
	Dim sVersion	As String			'バージョン番号
	Dim sDate		As String			'バージョン作成日付
	Dim sDisc		As String			'説明
	Dim sDirPath	As String			'バージョンフォルダパス
	Dim bNew		As Boolean			'True 付きバージョン
End Structure
Dim uVer()			As stVersion = Nothing		'セットアップバージョン配列
Dim iSelIdx			As Int32 = -1				'選択された行インデックス

Dim iApp			As Int32					'実行APP 0:Sizuka Tool  1:Sizuka data manager
Dim iNewApp			As Int32					'新バージョンインストールAPP
Dim iJob			As Int32 = -1               'bgwSetupのジョブ変数

''Dim bDotNet			As Boolean					'DotNetセットアップがVersionsフォルダへ存在するか
'バージョンアップアプリ識別
Enum eApp
	SZKTOOL = 0
	SZKANA
End Enum

Public p_sMesVersion As String = ""               '測定ツールバージョン(数字4桁)
Public p_sAnaVersion As String = ""               '解析ツールバージョン(数字4桁)

Private m_APP_Title	As String = "Sizuka System Version setup"

''' <summary>
''' フォームロード
''' </summary>
''' <param name="sender"></param>
''' <param name="e"></param>
Private Sub frmSetup_Load(sender As Object, e As EventArgs) Handles Me.Load
Try
	Me.Text = m_APP_Title & " [" & My.Application.Info.Version.ToString & "]"

	'起動状態がセットアップ付きか確認 新セットアップボタン有効/無効
	ConfirmWithSetup()

	'タブページを設定
	tcVersion.TabPages(eAPP.SZKTOOL).Text	= "Sizuka Tool"
	tcVersion.TabPages(eAPP.SZKANA).Text	= "Sizuka Data Manager"
	tcVersion.SelectedIndex					= If(iApp=-1, eApp.SZKTOOL, iApp)

	'バージョンリストを表示する
	dgvVersionsInit(dgvTVersion)			'dgvの初期化 SZKTool
	dgvVersionsInit(dgvMVersion)			'dgvの初期化 SZKAnaTool
	CurrentVersionDisp(eAPP.SZKTOOL,	p_sMesVersion)		'現在のインストールバージョン表示
	CurrentVersionDisp(eAPP.SZKANA,		p_sAnaVersion)		'現在のインストールバージョン表示

	'APPフォルダ状態を読込みセットアップバージョン情報を作成する
	MakeVersionsStructure(If(iApp=-1, eApp.SZKTOOL, iApp))
	VersioInfoSet(If(iApp=-1, eApp.SZKTOOL, iApp))

    'CurrentCell を Nothing にしてフォーカス時の反転を防止
    dgvTVersion.CurrentCell = Nothing
    dgvMVersion.CurrentCell = Nothing

	sstLabel1.Text = ""
	ckbSilent.Checked = True				'サイレント有効

	'列比率保存
	SaveColumnRatios(dgvTVersion)			
	SaveColumnRatios(dgvMVersion)


Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
End Try	
End Sub

''' <summary>
''' 起動状態がセットアップ付きか確認 新セットアップボタン有効/無効
'''   iAppへアプリケーション種別をセット
'''   btnStartの有効無効
''' </summary>
''' <returns>0:セットアップなし  1:セットアップ付き -1:処理失敗</returns>
Private Function ConfirmWithSetup() As Int32
Try
	Dim sExecuteDir		As String = Path.GetDirectoryName(Application.ExecutablePath)
	Dim stSourcePath	As String = Path.Combine(sExecuteDir, SETUPFILES)
	If Not Directory.Exists(stSourcePath)
		btnStart.Enabled = False
	ElseIf Not File.Exists(Path.Combine(stSourcePath, MSSetupEXE))
		btnStart.Enabled = False
	Else
		btnStart.Enabled	= True
		btnSwitch.Enabled	= False
	End If
	iApp = -1
	If File.Exists(Path.Combine(stSourcePath, SizukaToolMSIName))
		iApp = eApp.SZKTOOL			'Sizuka Toolセットアップ付き
	End If
	If File.Exists(Path.Combine(stSourcePath, SizukaAnaMSIName))
		iApp = eApp.SZKANA			'Sizuka Data Managerセットアップ付き
	End If
	If iApp=-1
		Return 0
	End If
	Return 1
Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
	Return -1
End Try
End Function


''' <summary>
''' セットアップバージョン配列内容をDGVへ表示する
''' </summary>
''' <param name="iSel"></param>
Private Sub VersioInfoSet(ByVal iSel As int16)
Dim dv	As DataGridView = If(iSel=eAPP.SZKTOOL, dgvTVersion, dgvMVersion)
Dim i	As Int32
Try
	dv.Rows.Clear()
	If IsNothing(uVer)
		Exit Sub
	End If
	For i=0 To uVer.GetUpperBound(0)
		dv.Rows.Add()
		dv.Item(0, i).Value = uVer(i).bSelect
		dv.Item(1, i).Value = uVer(i).sVersion
		dv.Item(2, i).Value = uVer(i).sDate
		dv.Item(3, i).Value = uVer(i).sDisc
		If uVer(i).bNew
			dv.Rows(i).DefaultCellStyle.ForeColor = Color.Blue
		End If
	Next

Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
End Try	
End Sub

''' <summary>
''' APPフォルダ状態を読込みセットアップバージョン情報を作成する
''' </summary>
''' <param name="iSel">0:Sizuka Tool 1:Sizuka Data Manager</param>
''' <returns>-1:例外発生 1:バージョンフォルダなし 0:成功</returns>
Private Function MakeVersionsStructure(ByVal iSel As int16) As Int32
Dim sPathVer()	As String = Nothing
Dim dv			As DataGridView = If(iSel=eAPP.SZKTOOL, dgvTVersion, dgvMVersion)
Dim i			As int32
Dim sDisc		As String = Nothing
Dim bNew		As Boolean = False
Try
	'インストール場所の確認
	If Not Directory.Exists(APP_Path)
		Directory.CreateDirectory(APP_Path)
	End If
	'Versions場所の確認
	If Not Directory.Exists(APPVersions_Path)
		Directory.CreateDirectory(APPVersions_Path)
	End If
	uVer = Nothing
	'Versionフォルダ一覧を取得する
	Array.Resize(sPathVer, 0)
	'自身のSetupフォルダ内確認
	If File.Exists(Path.Combine( Application.StartupPath, SETUPFILES, SizukaToolMSIName))
		iNewApp = eApp.SZKTOOL
	ElseIf File.Exists(Path.Combine( Application.StartupPath, SETUPFILES, SizukaAnaMSIName))
		iNewApp = eApp.SZKANA
	Else
		iNewApp = -1
	End If
	If iNewApp<>-1
		If iNewApp = iSel
			'自身のSetupフォルダ
			Array.Resize(sPathVer, sPathVer.Length+1)
			sPathVer(sPathVer.GetUpperBound(0)) = Path.Combine( Application.StartupPath, "" )
			bNew = True
		End If
	End If
	For Each sPath As String In Directory.GetDirectories(APPVersions_Path, If(iSel=eAPP.SZKTOOL, "TVer*","MVer*"), SearchOption.TopDirectoryOnly).OrderByDescending(Function(d) d)
		If Path.GetFileNameWithoutExtension(sPath).Length = 8
		'ファイル名長さでフィルタ 8文字 XVer9999
			Array.Resize(sPathVer, sPathVer.Length+1)
			sPathVer(sPathVer.GetUpperBound(0)) = sPath
		End If
	Next
	If sPathVer.Length <= 0
		Return 1			'バージョンが存在しない
	End If
	Array.Resize(uVer, 0)
	For i = 0 To sPathVer.GetUpperBound(0)
		Array.Resize(uVer, uVer.Length+1)
		GetDiscriptionFromFile(Path.Combine(sPathVer(i), DISC_FILE), sDisc)			'Discription.txtを読込む
		Dim sBuf() As String = sDisc.split(vbCrLf)
		uVer(i).sVersion = sBuf(0)															'先頭行がバージョン番号
		'setup.exeの更新日時
		uVer(i).sDate = System.IO.File.GetLastWriteTime(Path.Combine(sPathVer(i), SETUPFILES, MSSetupEXE)).ToString("yyyy/MM/dd")
		uVer(i).sDisc = sDisc.Replace(sBuf(0) & vbcrlf, "")									'先頭行を削除
		uVer(i).sDisc = sDisc.Substring(0, sDisc.Length-2)									'最終行の改行を削除
		uVer(i).sDirPath = sPathVer(i)														'セットアップバージョンフォルダパス
		If Not (i = 0 And bNew)
		'自身フォルダ無効時はFalse
			uVer(i).bNew = False
		Else
			uVer(i).bNew = True
		End if
	Next
	Return 0
Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
	Return -1
End Try	
End Function
''' <summary>
''' 指定パステキストファイルを全て読込む
''' </summary>
''' <param name="sPath">指定パステキストファイル</param>
''' <param name="sDisc">全テキスト</param>
''' <returns>0:成功 -1:失敗</returns>
Private Function GetDiscriptionFromFile(ByVal sPath As String, Byref sDisc As String) As Int32
Try
	Using file As New StreamReader(sPath, Encoding.UTF8)
		sDisc = file.ReadToEnd
	End Using
	Return 0
Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
	Return -1
End Try	
End Function


''' <summary>
''' バージョンデータグリッドビュー初期表示設定
''' </summary>
Private Sub dgvVersionsInit(ByRef dgv As DataGridView)
Try
	With dgv
	.Columns.Clear()
	.EnableHeadersVisualStyles		= False			'Visualスタイル不適用
	.ReadOnly						= False			'読取専用
	.RowHeadersVisible				= False			'列ヘッダ消去
	.AllowUserToAddRows				= False			'追加用行を消去
	.AllowUserToDeleteRows			= True			'削除可能
	.AllowUserToResizeRows			= False			'行サイズ
	.AllowUserToOrderColumns		= False			'ソート不可
	.CurrentCell					= Nothing
	.Font							= New Font(BASE_FONT, 10)
	.ScrollBars						= ScrollBars.Both
	.RowTemplate.Height				= 24					'行高さ
	.ColumnHeadersHeightSizeMode	= DataGridViewColumnHeadersHeightSizeMode.EnableResizing
	.ColumnHeadersHeight			= 24			'ヘッダ行高さ
	.ColumnHeadersDefaultCellStyle.BackColor	= Color.LemonChiffon			'ヘッダ行背景色
	.SelectionMode								= DataGridViewSelectionMode.CellSelect
	.MultiSelect								= False
	.DefaultCellStyle.WrapMode = DataGridViewTriState.True
	.AutoSizeRowsMode = DataGridViewAutoSizeRowsMode.AllCells

	'カラムヘッダセット
	.Columns.Clear()
	' チェックボックス列作成
	Dim chk As New DataGridViewCheckBoxColumn()
	chk.Name = "Select"
	chk.HeaderText = "Select"
	chk.Width = 60			' 幅指定（任意）
	chk.ThreeState = False  ' 2値（True/False）にする場合

	' DataGridView に追加
	.Columns.Add(chk)

	.Columns.Add(1 , "Versions")
	.Columns.Add(2 , "Update date")
	.Columns.Add(3 , "Discription")
	.Columns(3).Width		= 400
	.Columns(3).DefaultCellStyle.Font		= New Font(BASE_FONT, 8)
	If iApp=-1
		.Columns(0).ReadOnly				= False			'読取専用
	Else
		.Columns(0).ReadOnly				= True			'読取専用
	End If
	.Columns(1).ReadOnly					= True			'読取専用
	.Columns(2).ReadOnly					= True			'読取専用
	.Columns(3).ReadOnly					= True			'読取専用

	.ClearSelection()
	.Enabled = True
	.ReadOnly = False


	End With

Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
End Try	
End Sub


''' <summary>
''' 指定したアプリが起動されているか確認する
''' </summary>
''' <param name="sAppName">確認したいプロセス名（拡張子 .exe を除いた名前）</param>
''' <returns>0:起動指定ない 1:起動している -1:失敗</returns>
Private Function CheckRunApprication(ByVal sAppName As String) As Int32
Try
    '同名プロセスを取得
    Dim ps() As Process = Process.GetProcessesByName(sAppName)
    If ps.Length > 0 Then
        Return 1
    Else
        Return 0
    End If
Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
	Return -1
End Try
End Function



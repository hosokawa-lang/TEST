    ' RGB → HSV
    Sub ColorToHSV(ByVal color As Color, ByRef hue As Single, ByRef saturation As Single, ByRef value As Single)
	Try
        Dim max As Single = Math.Max(color.R, Math.Max(color.G, color.B))
        Dim min As Single = Math.Min(color.R, Math.Min(color.G, color.B))
        value = max / 255.0F

        Dim delta As Single = max - min
        saturation = If(max = 0, 0, delta / max)

        If delta = 0 Then
            hue = 0
        ElseIf max = color.R Then
            hue = 60 * (((color.G - color.B) / delta) Mod 6)
        ElseIf max = color.G Then
            hue = 60 * (((color.B - color.R) / delta) + 2)
        Else
			' 整数ではなく浮動小数点で計算
			hue = 60.0F * (((CSng(color.R) - CSng(color.G)) / delta) + 4.0F)
		End If

        If hue < 0 Then hue += 360

	Catch ex As Exception

	End Try
    End Sub

    ' HSV → RGB
    Function ColorFromHSV(hue As Single, saturation As Single, value As Single) As Color
	Try
        Dim c As Single = value * saturation
        Dim x As Single = c * (1 - Math.Abs((hue / 60) Mod 2 - 1))
        Dim m As Single = value - c
        Dim r1, g1, b1 As Single

        If hue < 60 Then
            r1 = c : g1 = x : b1 = 0
        ElseIf hue < 120 Then
            r1 = x : g1 = c : b1 = 0
        ElseIf hue < 180 Then
            r1 = 0 : g1 = c : b1 = x
        ElseIf hue < 240 Then
            r1 = 0 : g1 = x : b1 = c
        ElseIf hue < 300 Then
            r1 = x : g1 = 0 : b1 = c
        Else
            r1 = c : g1 = 0 : b1 = x
        End If

        Dim r As Integer = CInt((r1 + m) * 255)
        Dim g As Integer = CInt((g1 + m) * 255)
        Dim b As Integer = CInt((b1 + m) * 255)

        Return Color.FromArgb(r, g, b)

	Catch ex As Exception

	End Try
    End Function
#end if

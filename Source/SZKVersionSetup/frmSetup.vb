Private Sub ResizeAllDgv()
    For Each tab As TabPage In tcVersion.TabPages
        For Each ctrl As Control In tab.Controls
            If TypeOf ctrl Is DataGridView Then
                ResizeColumns(DirectCast(ctrl, DataGridView))
            End If
        Next
    Next
End Sub

Private columnRatios As New Dictionary(Of DataGridView, List(Of Double))
Private Sub SaveColumnRatios(dgv As DataGridView)

    Dim totalWidth As Integer = dgv.ClientSize.Width
    Dim ratios As New List(Of Double)

    For Each col As DataGridViewColumn In dgv.Columns
        ratios.Add(col.Width / totalWidth)
    Next

    columnRatios(dgv) = ratios
End Sub
Private Sub ResizeColumns(dgv As DataGridView)

    If Not columnRatios.ContainsKey(dgv) Then Exit Sub

    Dim totalWidth As Integer = dgv.ClientSize.Width
    Dim ratios = columnRatios(dgv)

    For i As Integer = 0 To dgv.Columns.Count - 1
        dgv.Columns(i).Width = totalWidth * ratios(i)
    Next

End Sub





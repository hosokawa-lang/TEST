        sender.CommitEdit(DataGridViewDataErrorContexts.Commit)
    End If
End Sub

Private Sub dgvTVersion_CellValueChanged(sender As Object, e As DataGridViewCellEventArgs) Handles dgvTVersion.CellValueChanged,dgvMVersion.CellValueChanged
Try
    ' チェックボックス列以外は無視
    If e.ColumnIndex <> sender.Columns(0).Index OrElse e.RowIndex < 0 Then
        Return
    End If
    ' チェックされた行を基準にする
    Dim checkedRow = sender.Rows(e.RowIndex)
    If CBool(checkedRow.Cells(0).Value) = True Then
        ' 他の行のチェックを外す
        For Each r As DataGridViewRow In sender.Rows
            If r.Index <> e.RowIndex Then
                r.Cells(0).Value = False
            End If
        Next
    End If

Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
End Try
End Sub
''' <summary>
''' セットアップ開始ボタン
''' </summary>
''' <param name="sender"></param>
''' <param name="e"></param>
Private Sub btnStart_Click(sender As Object, e As EventArgs) Handles btnStart.Click
Try
	Dim iRet As Int32 = 0
	'セットアップ付きか確認
	Dim sExecuteDir		As String = Path.GetDirectoryName(Application.ExecutablePath)
	Dim stSourcePath	As String = Path.Combine(sExecuteDir, SETUPFILES)
	If Not Directory.Exists(stSourcePath)
		Exit Sub
	End If
	If Not File.Exists(Path.Combine(stSourcePath, MSSetupEXE))
		Exit Sub
	End If
	iApp = -1
	If File.Exists(Path.Combine(stSourcePath, SizukaToolMSIName))
		iApp = eApp.SZKTOOL			'Sizuka Toolセットアップ付き
	End If
	If File.Exists(Path.Combine(stSourcePath, SizukaAnaMSIName))
		iApp = eApp.SZKANA			'Sizuka Data Managerセットアップ付き
	End If
	If iApp=-1
		Exit Sub
	End If
	'セットアップアプリの起動確認
	iRet = CheckRunApprication(Path.GetFileNameWithoutExtension(If(iApp=eApp.SZKTOOL, SizukaToolEXEName, SizukaAnaEXEName)))
	If iRet = 0
		'bgwSetupスレッド起動
		If Not bgwSetup.IsBusy
			sstLabel1.Text = "The new setup sequence begins."
			iJob = 0
			bgwSetup.WorkerReportsProgress = True
			bgwSetup.RunWorkerAsync()                         
		End If
	Else
		MsgBox("Please close the application to run it.", MsgBoxStyle.Information, m_APP_Title)
	End If

Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
End Try
End Sub

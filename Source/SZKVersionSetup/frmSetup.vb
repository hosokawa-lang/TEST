''' <summary>
''' セットアップスレッドメイン処理
''' </summary>
''' <param name="sender"></param>
''' <param name="e"></param>
Private Sub bgwSetup_DoWork(sender As Object, e As DoWorkEventArgs) Handles bgwSetup.DoWork
Try
Dim sExeFile	As String = If(iApp=eApp.SZKTOOL, SizukaToolEXEName,	SizukaAnaEXEName)
Dim sAppName	As String = If(iApp=eApp.SZKTOOL, SizukaToolAppName,	SizukaAnaAPPName)
Dim sIniName	As String = If(iApp=eApp.SZKTOOL, SizukaToolINI,		SizukaAnaINI)
Dim sMsiName	As String = If(iApp=eApp.SZKTOOL, SizukaToolMSIName,	SizukaAnaMSIName)
Dim sUnInsBat	As String = If(iApp=eApp.SZKTOOL, SZKToolUnInstalBat,	SZKAnaUnInstalBat)
Dim sGUID	 As String = Nothing
Dim sw1		 As New Stopwatch
Do
	Try
	If bgwSetup.CancellationPending
		e.Cancel = True
		Exit Do
	End If
	Select Case iJob
	Case 0	'初期準備
		bgwSetup.ReportProgress(0, "In preparation...")
		Dim sDotNetDir = Path.Combine(APPVersions_Path, MSDotNet481Folder)
		If Not Directory.Exists( sDotNetDir )
		'.Net4.81セットアップフォルダがVersionsフォルダにあるか、無ければ作成する
			Dim stSourcePath		As String = Path.Combine(If(iSelIdx<>-1, uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), SETUPFILES, MSDotNet481Folder)
			Dim stDestPath			As String = sDotNetDir
			CopyDirectory(stSourcePath, stDestPath, True)
		End If
		sw1.Stop
		sw1.Reset
		iJob = 10

	Case 10	'初期化ファイルのバックアップ
		bgwSetup.ReportProgress(0, "Backing up initialization files...")
		If File.Exists( Path.Combine(APP_Path_Old, sAppName, sExeFile) )
		'古インストール場所に存在する
			sGUID = GetInstalledAppGuidByDisplayName( sAppName )			'GUIDを取得
			If IsNothing(sGUID)
			'古アンインストール必要なし
				iJob = 40
			Else
			'初期化ファイルバックアップと古アンインストールへ
				Dim sIniPath As String = Path.Combine(APP_Path_Old, sAppName, sIniName)
				If File.Exists( sIniPath )
					File.Copy( sIniPath, Path.Combine(If(iSelIdx<>-1, uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), sIniName),True )
				End If
				iJob = 20
			End If
		Else
		'古アンインストール必要なし
			iJob = 40
		End If

	Case 20	'古バージョンをアンインストール
		bgwSetup.ReportProgress(0, "Uninstalling the old version...")
		UninstallApplicationByGuid( sGUID, ckbSilent.Checked )
		sw1.Start
		iJob = 30

	Case 30
		If sw1.Elapsed.TotalSeconds>0
			bgwSetup.ReportProgress(0, "Uninstallation of the old version completed.")
			sw1.Stop
			sw1.Reset
			iJob = 40
		End If

	Case 40	'新場所のアンインストール
		bgwSetup.ReportProgress(0, "Uninstalling the previous version...")
		If File.Exists( Path.Combine(APP_Path, sAppName, sExeFile) )
		'新場所インストール場所にバージョンが存在する
			sGUID = GetInstalledAppGuidByDisplayName( sAppName )			'GUIDを取得
			If IsNothing(sGUID)
			'現アンインストール必要なし
				iJob = 100
			Else
			'初期化ファイルバックアップと現アンインストールへ
				IniFileBackup()
#If 0
				Dim sListIniPath	As String = Path.Combine(APP_Path, sAppName, sIniName)
				Dim ini As New IniFile
				ini.Load(sListIniPath)
				Dim DevSelIdx	As String = ini.ReadValue("Remote", "SelectedEquipment")
				Dim DevName		As String = ini.ReadValue("Remote", "EquipName" & DevSelIdx)
				Dim sSettingIniPath As String = Path.Combine(SIZUKA_PATH, DevName, "DeviceSetting.ini")
				If File.Exists( sListIniPath )
					File.Copy( sListIniPath, Path.Combine( If(iSelidx<>-1,uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), sIniName), True )
				End If
				If File.Exists( sSettingIniPath )
					File.Copy( sSettingIniPath, Path.Combine( If(iSelidx<>-1,uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), "DeviceSetting.ini"),True )
				End If
				sSettingIniPath = Path.Combine(SIZUKA_PATH, DevName, "TempPara.ini")
				If File.Exists( sSettingIniPath )
					File.Copy( sSettingIniPath, Path.Combine( If(iSelidx<>-1,uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), "TempPara.ini"),True )
				End If
#end if

				iJob = 50
			End If
		Else
		'現アンインストール必要なし
			iJob = 100
		End If

	Case 50 '現アンインストール
		UninstallApplicationByGuid( sGUID, ckbSilent.Checked )
		sw1.Start
		iJob = 60

	Case 60
		If sw1.Elapsed.TotalSeconds>0
			bgwSetup.ReportProgress(0, "Uninstall the previous version.")
			sw1.Stop
			sw1.Reset
			iJob = 100
		End If

	Case 70
	Case 80
	Case 90

	Case 100 '新場所インストール
		bgwSetup.ReportProgress(0, "Installing new version...")
		Dim sDotNetFolder As String = Path.Combine(If(iSelIdx<>-1, uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), SETUPFILES, MSDotNet481Folder)
		If Not Directory.Exists(sDotNetFolder)
			Dim stSourcePath	As String = Path.Combine(APPVersions_Path, MSDotNet481Folder)
			Dim stDestPath		As String = Path.Combine(If(iSelIdx<>-1, uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), SETUPFILES, MSDotNet481Folder)
			CopyDirectory(stSourcePath, stDestPath, True)
		End If
		Dim sMSIPath As String = Path.Combine(If(iSelIdx<>-1, uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), SETUPFILES, sMsiName)
		InstallApplication( sMSIPath, Path.Combine( APP_Path, If(iApp=eApp.SZKTOOL, SZK_MES_Path, SZK_ANA_Path) ), ckbSilent.Checked )
		sw1.Start
		iJob = 110

	Case 110
		If sw1.Elapsed.TotalSeconds>0
			bgwSetup.ReportProgress(0, "New version installation complete.")
			sw1.Stop
			sw1.Reset
			iJob = 200
		End If

	Case 200 '初期化ファイル移植
		bgwSetup.ReportProgress(0, "Porting the initialization file...")
		Dim sIniPath As String = Path.Combine(If(iSelIdx<>-1, uVer(iSelIdx).sDirPath, Path.GetDirectoryName(Application.ExecutablePath)), sIniName)
		If File.Exists( sIniPath )
			File.Copy( sIniPath, Path.Combine(APP_Path, sAppName, sIniName), True )
		End If
		iJob = 220

	Case 220  'Versionsセットアップイメージ作成
		If iSelIdx = -1

		''ElseIf uVer(iSelIdx).bNew
		'新バージョンインストール時は、Versionsへイメージ作成、自身をC:\SZKApps\へコピーする
			Dim sDir As String = Path.Combine( APPVersions_Path, If(iApp=eApp.SZKTOOL, "T", "M") & uVer(If(iSelIdx<>-1, iSelIdx, 0)).sVersion.Replace(".","") ).Replace(" ","")
			If Not Directory.Exists( sDir )
			'セットアップイメージフォルダ(XVer9999)が存在しない場合は作成
				Directory.CreateDirectory( sDir )
			End If
			Dim sExecuteDir		As String = Path.GetDirectoryName(Application.ExecutablePath)
			Dim stSourcePath	As String = Path.Combine(sExecuteDir, SETUPFILES)
			Dim stDestPath		As String = Path.Combine(sDir, SETUPFILES)
			'If Not bDotNet
			'	'SetupFilesフォルダ上書きコピー
			'	CopyDirectory(stSourcePath, stDestPath, True)
			'Else
				Directory.CreateDirectory(stDestPath)
				FileSystem.FileCopy(Path.Combine(stSourcePath, MSSetupEXE), Path.Combine(stDestPath, MSSetupEXE))
				Select Case iApp
				Case eApp.SZKTOOL
					FileSystem.FileCopy(Path.Combine(stSourcePath, SizukaToolMSI), Path.Combine(stDestPath, SizukaToolMSI))
				Case eApp.SZKANA
					FileSystem.FileCopy(Path.Combine(stSourcePath, SizukaAnaMSI), Path.Combine(stDestPath, SizukaAnaMSI))
				End Select
			'End If
			If File.Exists(Path.Combine(sExecuteDir, DISC_FILE))
				'Discription.txt コピー
				FileSystem.FileCopy(Path.Combine(sExecuteDir, DISC_FILE), Path.Combine(sDir, DISC_FILE))
			End If
			If File.Exists(Path.Combine(sExecuteDir, UnInstallerInfo))
				'AppUninstallerInfo.ps1 コピー
				FileSystem.FileCopy(Path.Combine(sExecuteDir, UnInstallerInfo), Path.Combine(sDir, UnInstallerInfo))
			End If
			If File.Exists(Path.Combine(sExecuteDir, sUnInsBat))
				'SizukaAnaVersionUp.bat コピー
				FileSystem.FileCopy(Path.Combine(sExecuteDir, sUnInsBat), Path.Combine(sDir, sUnInsBat))
			End If
			'自身のコピー SZKVersionSetup.exe コピー
			FileSystem.FileCopy(Application.ExecutablePath, Path.Combine(APP_Path, Path.GetFileName(Application.ExecutablePath)))
		End If
		'SQLiteDBファイル初期化(削除)
		If File.Exists(Path.Combine(SIZUKA_PATH, DBDAT_PATH, "SizukaDB.db")) 
			File.Delete(Path.Combine(SIZUKA_PATH, DBDAT_PATH, "SizukaDB.db"))
		End If

		iJob = 230

	Case 230 '終了処理
		bgwSetup.ReportProgress(0, "The setup sequence is complete.")
		If iSelIdx<>-1
			Directory.Delete(Path.Combine(uVer(iSelIdx).sDirPath, SETUPFILES, MSDotNet481Folder), True)
		End If
		e.Result = "COMPLETE"
		Exit Do
		
	Case Else
		iJob = -1
		e.Result = "ABORT"
		Exit Sub
	End Select
	Thread.Sleep(10)

	Catch ex As Exception
		Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
		iJob = -9
	End Try
Loop
Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
End Try
End Sub
''' <summary>
''' 初期化ファイルバックアップ C:\SZKApps\Versions\XXXX9999へバックアップ
''' </summary>
Private Sub IniFileBackup()
Try
	Dim sAppName	As String = If(iApp=eApp.SZKTOOL, SizukaToolAppName,	SizukaAnaAPPName)
	Dim sIniName	As String = If(iApp=eApp.SZKTOOL, SizukaToolINI,		SizukaAnaINI)
	Dim sListIniPath	As String = Path.Combine(APP_Path, sAppName, sIniName)
	Dim ini As New IniFile
	ini.Load(sListIniPath)
	Dim DevSelIdx	As String = ini.ReadValue("Remote", "SelectedEquipment")
	Dim DevName		As String = ini.ReadValue("Remote", "EquipName" & DevSelIdx)
	Dim sSettingIniPath As String = Path.Combine(SIZUKA_PATH, DevName, "DeviceSetting.ini")
	Dim sCurrentVerFolder As String = ""
	Select Case iApp
	Case eApp.SZKTOOL
		sCurrentVerFolder = Path.Combine(APPVersions_Path, If(iSelIdx<>-1, "TVer" & p_sMesVersion, Path.GetDirectoryName(Application.ExecutablePath)))
	Case eApp.SZKANA
		sCurrentVerFolder = Path.Combine(APPVersions_Path, If(iSelIdx<>-1, "MVer" & p_sAnaVersion, Path.GetDirectoryName(Application.ExecutablePath)))
	End Select
	If sCurrentVerFolder=""
		sCurrentVerFolder = Path.GetDirectoryName(Application.ExecutablePath)
	End If

	If File.Exists( sListIniPath )
		File.Copy( sListIniPath, Path.Combine( sCurrentVerFolder, sIniName), True )
	End If
	If File.Exists( sSettingIniPath )
		File.Copy( sSettingIniPath, Path.Combine( sCurrentVerFolder, "DeviceSetting.ini"),True )
	End If
	sSettingIniPath = Path.Combine(SIZUKA_PATH, DevName, "TempPara.ini")
	If File.Exists( sSettingIniPath )
		File.Copy( sSettingIniPath, Path.Combine( sCurrentVerFolder, "TempPara.ini"),True )
	End If

Catch ex As Exception
	Call WriteLog(System.Reflection.MethodBase.GetCurrentMethod.Name & " : " & ex.Message & ex.StackTrace)
End Try
End Sub

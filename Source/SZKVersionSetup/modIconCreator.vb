''' <summary>
''' pngファイルの系統色を変更しICOファイルを作成する
''' </summary>
''' <param name="inputPng">入力PNGファイルパス</param>
''' <param name="outputIco">出力ICOファイルパス</param>
''' <param name="targetColor">変換後の色</param>
Public Sub PngToICOWithColorConv(ByVal inputPng As String, ByVal outputIco As String, ByVal targetColor As Color)
    ' ICO用のサイズリスト
    Dim sizes() As Integer = {16, 32, 48, 64, 128, 256}
Try
    ' 元画像読み込み
    Using original As New Bitmap(inputPng)
        ' 変換済みビットマップをサイズごとに格納
        Dim icons As New List(Of Bitmap)
        For Each sz In sizes
            Dim resized As New Bitmap(sz, sz, PixelFormat.Format32bppArgb)
            Using g As Graphics = Graphics.FromImage(resized)
                g.Clear(Color.Transparent)
                g.InterpolationMode = Drawing2D.InterpolationMode.HighQualityBicubic

                ' 元画像を縮小して描画
                g.DrawImage(original, 0, 0, sz, sz)
            End Using

            ' 緑系に変換 (透明は保持)
            For y As Integer = 0 To resized.Height - 1
                For x As Integer = 0 To resized.Width - 1
                    Dim px As Color = resized.GetPixel(x, y)
                    ' アルファが0なら透明
                    If px.A > 0 Then
						If px.B > px.R And px.B > px.G Then
							' 元の明度を保ったままLime系に変換
							Dim brightness As Single = px.GetBrightness() * 1.5
							Dim newR As Integer = CInt(targetColor.R * brightness)
							Dim newG As Integer = CInt(targetColor.G * brightness)
							Dim newB As Integer = CInt(targetColor.B * brightness)
							resized.SetPixel(x, y, Color.FromArgb(px.A, Clamp(newR), Clamp(newG), Clamp(newB)))
	                    End If
                    End If
                Next
            Next
            icons.Add(resized)
        Next
        ' ICOとして保存
        SaveIco(outputIco, icons)
    End Using
    Console.WriteLine("ICO生成完了: " & outputIco)
Catch ex As Exception

End Try
End Sub

' 値を0-255にクランプ
Private Function Clamp(value As Integer) As Integer
    If value < 0 Then Return 0
    If value > 255 Then Return 255
    Return value
End Function

' ICO保存関数
Private Sub SaveIco(filePath As String, images As List(Of Bitmap))
Try
    Using fs As New FileStream(filePath, FileMode.Create)
        ' ICOヘッダ
        fs.WriteByte(0) : fs.WriteByte(0)   ' Reserved
        fs.WriteByte(1) : fs.WriteByte(0)   ' Image type (1 = icon)
        fs.WriteByte(CByte(images.Count)) : fs.WriteByte(0) ' Number of images

        ' 各イメージのエントリは後で書き込むのでオフセット計算
        Dim imageDataList As New List(Of Byte())
        Dim offset As Integer = 6 + 16 * images.Count

        For Each bmp In images
            Using ms As New MemoryStream()
                bmp.Save(ms, ImageFormat.Png)
                Dim data() As Byte = ms.ToArray()
                imageDataList.Add(data)

                ' 幅/高さ (0なら256)
                fs.WriteByte(If(bmp.Width >= 256, 0, CByte(bmp.Width)))
                fs.WriteByte(If(bmp.Height >= 256, 0, CByte(bmp.Height)))
                fs.WriteByte(0) ' Color palette
                fs.WriteByte(0) ' Reserved
                fs.WriteByte(0) : fs.WriteByte(0) ' Color planes
                fs.WriteByte(0) : fs.WriteByte(0)
                fs.Write(BitConverter.GetBytes(data.Length), 0, 4) ' Image size
                fs.Write(BitConverter.GetBytes(offset), 0, 4)       ' Offset

                offset += data.Length
            End Using
        Next

        ' 画像データを書き込み
        For Each fdata In imageDataList
            fs.Write(fdata, 0, fdata.Length)
        Next
    End Using

Catch ex As Exception

End Try
End Sub


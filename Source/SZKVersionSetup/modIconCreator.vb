Sub CreateTransparentIcoFromPng(pngPath As String, icoPath As String)
    Try
        Dim sizes As Integer() = {16, 32, 48, 64, 128, 256}
        Using fs As New FileStream(icoPath, FileMode.Create)
            ' ICO ヘッダ
            fs.Write(New Byte() {0, 0, 1, 0, CByte(sizes.Length And 255), CByte(sizes.Length >> 8)}, 0, 6)

            Dim imageDataList As New List(Of Byte())
            For Each size In sizes
                Try
                    Using srcBmp As New Bitmap(pngPath)
                        ' 透明を保持する Bitmap を作成
                        Using bmp As New Bitmap(size, size, PixelFormat.Format32bppArgb)
                            Using g As Graphics = Graphics.FromImage(bmp)
                                g.Clear(Color.Transparent)
                                g.InterpolationMode = Drawing2D.InterpolationMode.HighQualityBicubic
                                g.DrawImage(srcBmp, 0, 0, size, size)
                            End Using

                            ' PNG をメモリに保存
                            Dim ms As New MemoryStream()
                            bmp.Save(ms, ImageFormat.Png)
                            Dim pngBytes() As Byte = ms.ToArray()
                            imageDataList.Add(pngBytes)

                            ' ICONDIRENTRY
                            fs.WriteByte(If(size <= 255, CByte(size), 0)) ' Width
                            fs.WriteByte(If(size <= 255, CByte(size), 0)) ' Height
                            fs.WriteByte(0) ' Color palette
                            fs.WriteByte(0) ' Reserved
                            fs.WriteByte(1) : fs.WriteByte(0) ' Color planes
                            fs.WriteByte(32) : fs.WriteByte(0) ' Bits per pixel

                            ' Image size
                            Dim imgSize = pngBytes.Length
                            fs.WriteByte(CByte(imgSize And 255))
                            fs.WriteByte(CByte((imgSize >> 8) And 255))
                            fs.WriteByte(CByte((imgSize >> 16) And 255))
                            fs.WriteByte(CByte((imgSize >> 24) And 255))

                            ' Offset placeholder (4 バイト)
                            fs.Write(New Byte() {0, 0, 0, 0}, 0, 4)
                        End Using
                    End Using
                Catch ex As Exception
                    Console.WriteLine($"サイズ {size} 生成エラー: {ex.Message}")
                End Try
            Next

            ' 画像データ書き込み
            Dim offset As Integer = 6 + 16 * sizes.Length
            Dim offsets(sizes.Length - 1) As Integer
            For i = 0 To imageDataList.Count - 1
                offsets(i) = offset
                fs.Write(imageDataList(i), 0, imageDataList(i).Length)
                offset += imageDataList(i).Length
            Next

            ' オフセット書き戻し
            fs.Seek(6, SeekOrigin.Begin)
            For i = 0 To imageDataList.Count - 1
                fs.Seek(12, SeekOrigin.Current)
                Dim o = offsets(i)
                fs.WriteByte(CByte(o And 255))
                fs.WriteByte(CByte((o >> 8) And 255))
                fs.WriteByte(CByte((o >> 16) And 255))
                fs.WriteByte(CByte((o >> 24) And 255))
            Next
        End Using
        Console.WriteLine("透明ICO作成完了")
    Catch ex As Exception
        Console.WriteLine("ICO生成例外: " & ex.Message)
    End Try
End Sub

Function BitmapToIcoBytes(bmp As Bitmap) As Byte()
Try
    Dim width = bmp.Width
    Dim height = bmp.Height
    Dim bmpBytes As Byte()

    Dim rect = New Rectangle(0, 0, width, height)
    Dim bmpData = bmp.LockBits(rect, ImageLockMode.ReadOnly, PixelFormat.Format32bppArgb)

    Dim stride As Integer = bmpData.Stride
    Dim totalBytes As Integer = stride * height
    Dim pixelBytes(totalBytes - 1) As Byte
    System.Runtime.InteropServices.Marshal.Copy(bmpData.Scan0, pixelBytes, 0, totalBytes)
    bmp.UnlockBits(bmpData)

    ' AND マスク作成（透明度128未満のピクセルを1に）
    Dim maskStride As Integer = ((width + 31) \ 32) * 4
    Dim mask(maskStride * height - 1) As Byte
    For y = 0 To height - 1
        For x = 0 To width - 1
            Dim idx = y * stride + x * 4
            Dim a As Byte = pixelBytes(idx + 3)
            If a < 128 Then
                mask((height - 1 - y) * maskStride + (x \ 8)) = mask((height - 1 - y) * maskStride + (x \ 8)) Or CByte(128 >> (x Mod 8))
            End If
        Next
    Next

    Using ms As New MemoryStream()
        ' BITMAPINFOHEADER
        ms.Write(BitConverter.GetBytes(40), 0, 4) ' Header size
        ms.Write(BitConverter.GetBytes(width), 0, 4)
        ms.Write(BitConverter.GetBytes(height * 2), 0, 4) ' height *2
        ms.Write(BitConverter.GetBytes(CShort(1)), 0, 2) ' planes
        ms.Write(BitConverter.GetBytes(CShort(32)), 0, 2) ' bpp
        ms.Write(New Byte(23) {}, 0, 24) ' rest zeros

        ' ピクセルデータ（下→上）
        For y = height - 1 To 0 Step -1
            For x = 0 To width - 1
                Dim idx = y * stride + x * 4
                ms.WriteByte(pixelBytes(idx + 0)) ' B
                ms.WriteByte(pixelBytes(idx + 1)) ' G
                ms.WriteByte(pixelBytes(idx + 2)) ' R
                ms.WriteByte(pixelBytes(idx + 3)) ' A
            Next
        Next

        ' AND マスク
        ms.Write(mask, 0, mask.Length)
        bmpBytes = ms.ToArray()
    End Using

    Return bmpBytes
Catch ex As Exception
    Return Nothing
End Try
End Function

Sub WhiteToTransparent()
    Dim inputPng As String = "input.png"
    Dim outputPng As String = "output_transparent.png"

    MakeBackgroundTransparent(inputPng, outputPng, Color.White) ' 白を透明に
    Console.WriteLine("透明PNG作成完了")
End Sub

Sub MakeBackgroundTransparent(inputPath As String, outputPath As String, bgColor As Color)
    Using bmp As New Bitmap(inputPath)
        ' 透明情報を持つ32bit形式に変換
        Using bmpArgb As New Bitmap(bmp.Width, bmp.Height, PixelFormat.Format32bppArgb)
            Using g As Graphics = Graphics.FromImage(bmpArgb)
                g.Clear(Color.Transparent)
                g.DrawImage(bmp, 0, 0)
            End Using

            ' 指定色を透明に変換
            For x As Integer = 0 To bmpArgb.Width - 1
                For y As Integer = 0 To bmpArgb.Height - 1
                    Dim c As Color = bmpArgb.GetPixel(x, y)
                    If c.ToArgb() = bgColor.ToArgb() Then
                        bmpArgb.SetPixel(x, y, Color.Transparent)
                    End If
                Next
            Next

            bmpArgb.Save(outputPath, ImageFormat.Png)
        End Using
    End Using
End Sub




Public   Sub Conv1()
Try
    ' Base64文字列（省略）
    Dim base64String As String = "" ' 省略
    Dim imageBytes() As Byte = Convert.FromBase64String(base64String)

    ' メモリ上に画像を読み込む
    Using ms As New MemoryStream(imageBytes)
        Dim bmp As New Bitmap(ms)

        For y As Integer = 0 To bmp.Height - 1
            For x As Integer = 0 To bmp.Width - 1
                Dim pixel As Color = bmp.GetPixel(x, y)
                Dim newColor As Color

                If pixel.A = 0 Then
                    ' 完全透明はそのまま
                    newColor = Color.FromArgb(0, 0, 0, 0)
                ElseIf pixel.B > pixel.R AndAlso pixel.B > pixel.G Then
                    ' 青が支配的な場合のみ変換
                    ' 青の強さを0～1に正規化
                    Dim blueRatio As Double = pixel.B / 255.0
                    ' LimeのRGBに元の明暗を掛ける
                    Dim r As Integer = CInt(Color.Lime.R * blueRatio)
                    Dim g As Integer = CInt(Color.Lime.G * blueRatio)
                    Dim b As Integer = CInt(Color.Lime.B * blueRatio)
                    newColor = Color.FromArgb(pixel.A, r, g, b)
                Else
                    ' 青でない部分は元の色を維持
                    newColor = pixel
                End If

                bmp.SetPixel(x, y, newColor)
            Next
        Next

        bmp.Save("output_lime_gradient.png", Imaging.ImageFormat.Png)
    End Using

    Console.WriteLine("変換完了: output_lime_gradient.png")
Catch ex As Exception

End Try
End Sub

